# NASA APOD. Safe to expose — it's a rate limit, not a secret.
# Get a free key at https://api.nasa.gov (DEMO_KEY works but is heavily limited).
NEXT_PUBLIC_NASA_API_KEY=DEMO_KEY

# Groq, for the "Ask the guide" AI panel. Server-side only — never prefix this
# with NEXT_PUBLIC_, or it will be bundled into the browser for anyone to read.
# Get a free key at https://console.groq.com. Without it the rest of the app
# works and the chat panel says it isn't configured.
GROQ_API_KEY=
